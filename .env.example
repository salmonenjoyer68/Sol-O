# OpenAI-compatible endpoint. Copy to .env and fill in.
# Groq:       BASE_URL=https://api.groq.com/openai/v1  MODEL=llama-3.3-70b-versatile
# OpenRouter: BASE_URL=https://openrouter.ai/api/v1    MODEL=openai/gpt-4o-mini
# Ollama:     BASE_URL=http://localhost:11434/v1       MODEL=llama3.2:1b
BASE_URL=
API_KEY=
MODEL=

# Optional per-agent model overrides; MODEL stays the fallback for every planet.
# Comma-separated name=model pairs, e.g. with Ollama:
# AGENT_MODELS=researcher=llama3.2:1b,writer=qwen2.5:14b
AGENT_MODELS=

# Optional: task used when sun.py is called without a task argument.
TASK_DESCRIPTION=

# Phase 4 tools. Leave TAVILY_API_KEY empty to run without search (claims unverified).
TAVILY_API_KEY=

# Telegram notifier. DRY_RUN=true prints the message instead of sending it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DRY_RUN=true

# Planets can call tools (kb_search, fetch_url, calc, recall) during a step.
# The knowledge base is the kb/ directory. POST /inbound's `source` is the
# conversation key: `recall` only searches earlier runs with the same source,
# and an empty or "unknown" source disables recall.

# Phase 5 limits and safety switch (defaults shown).
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
TOOL_TIMEOUT_SECONDS=15
RUN_TIMEOUT_SECONDS=180
MAX_AGENTS=7
REQUIRE_APPROVAL=true
AUTO_APPROVE=false
PENDING_TTL_HOURS=24
MAX_INPUT_CHARS=8000
